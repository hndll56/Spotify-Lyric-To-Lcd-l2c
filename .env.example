# Spotify API (jika menggunakan Spotify Web API langsung)
# SPOTIFY_CLIENT_ID=your_client_id_here
# SPOTIFY_CLIENT_SECRET=your_client_secret_here

# LRCLIB API (opsional - public API tidak butuh key)
# LRCLIB_API_URL=https://lrclib.net/api

# Serial Port Arduino (opsional - bisa di-set di main.py)
# SERIAL_PORT=COM5
# BAUD_RATE=115200

# Lyrics folder (opsional)
# LYRICS_FOLDER=lyrics